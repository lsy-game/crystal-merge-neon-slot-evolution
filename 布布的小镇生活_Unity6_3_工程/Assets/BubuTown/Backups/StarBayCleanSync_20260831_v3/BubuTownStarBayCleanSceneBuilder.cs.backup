                Cube(root, "Warm_Sun_Patch_Street_" + i, new Vector3(-1.8f + (i % 2) * 2.2f, 0.069f, z), new Vector3(3.5f, 0.01f, 2.0f), "SunPatch").transform.localRotation = Quaternion.Euler(0f, -18f, 0f);
            }

            for (var i = 0; i < 4; i++)
            {
                var z = -12.0f + i * 11.0f;
                Cube(root, "Left_Facade_Warm_Sunwash_" + i, new Vector3(-6.68f, 3.08f, z), new Vector3(0.035f, 3.2f, 3.8f), "FacadeWarmLight");
                Cube(root, "Right_Facade_Cool_Shadow_" + i, new Vector3(6.68f, 2.86f, z + 2.8f), new Vector3(0.035f, 3.0f, 3.5f), "FacadeCoolShadow");
            }

            Cube(root, "Sea_Air_Horizon_Mist", new Vector3(0f, 1.08f, 49.5f), new Vector3(26f, 0.20f, 0.08f), "OceanMist");
            Cube(root, "Ocean_Bright_Entrance_Glint", new Vector3(0f, 0.065f, 46.2f), new Vector3(22f, 0.018f, 0.12f), "OceanGlint");
            Cube(root, "Promenade_Long_Warm_Highlight", new Vector3(0f, 0.095f, 39.55f), new Vector3(12.5f, 0.014f, 0.26f), "SunPatch");
        }

