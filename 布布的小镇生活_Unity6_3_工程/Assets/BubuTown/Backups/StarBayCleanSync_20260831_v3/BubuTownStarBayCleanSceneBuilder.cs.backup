        private static void WallMat(string name, Color baseColor)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(256, 256, TextureFormat.RGBA32, false);
            for (var y = 0; y < 256; y++)
            {
                for (var x = 0; x < 256; x++)
                {
                    var grain = (((x * 13 + y * 7) % 23) - 11) / 255f;
                    var panelLine = (y % 64 == 0 || x % 96 == 0) ? -0.035f : 0f;
                    texture.SetPixel(x, y, Shift(baseColor, grain + panelLine));
                }
            }

            texture.Apply();
            SaveTextureMaterial(name, texturePath, texture, false, new Vector2(3f, 3f), Color.white);
        }

        private static void GlassMat(string name, Color baseColor)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(256, 256, TextureFormat.RGBA32, false);
            for (var y = 0; y < 256; y++)
            {
                for (var x = 0; x < 256; x++)
                {
                    var t = y / 255f;
                    var c = Color.Lerp(Shift(baseColor, -0.08f), Shift(baseColor, 0.18f), t);
                    c.a = baseColor.a;
                    texture.SetPixel(x, y, c);
                }
            }

            for (var i = 0; i < 4; i++)
            {
                Diagonal(texture, 24 + i * 52, 42 + i * 16, 112, new Color(0.93f, 0.98f, 1f, baseColor.a));
            }

            texture.Apply();
            SaveTextureMaterial(name, texturePath, texture, true, new Vector2(1f, 1f), Color.white);
        }

        private static void AwningMat(string name, Color baseColor)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(128, 128, TextureFormat.RGBA32, false);
            for (var y = 0; y < 128; y++)
            {
                for (var x = 0; x < 128; x++)
                {
                    var stripe = (x / 24) % 2 == 0 ? 0.06f : -0.04f;
                    var rib = y % 18 == 0 ? -0.06f : 0f;
                    texture.SetPixel(x, y, Shift(baseColor, stripe + rib));
                }
            }

            texture.Apply();
            SaveTextureMaterial(name, texturePath, texture, false, new Vector2(2f, 1f), Color.white);
        }

        private static void WoodMat(string name, Color baseColor)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(128, 128, TextureFormat.RGBA32, false);
            for (var y = 0; y < 128; y++)
            {
                for (var x = 0; x < 128; x++)
                {
                    var grain = Mathf.Sin((x + y * 0.35f) * 0.18f) * 0.035f;
                    var line = y % 26 == 0 ? -0.05f : 0f;
                    texture.SetPixel(x, y, Shift(baseColor, grain + line));
                }
            }

            texture.Apply();
            SaveTextureMaterial(name, texturePath, texture, false, new Vector2(3f, 1f), Color.white);
        }

        private static void WaterMat(string name, Color baseColor)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(256, 256, TextureFormat.RGBA32, false);
            for (var y = 0; y < 256; y++)
            {
                for (var x = 0; x < 256; x++)
                {
                    var gradient = Mathf.Lerp(-0.04f, 0.08f, y / 255f);
                    var wave = Mathf.Sin((x * 0.12f) + (y * 0.045f)) * 0.025f;
                    var fine = ((x + y * 3) % 37 == 0) ? 0.08f : 0f;
                    var c = Shift(baseColor, gradient + wave + fine);
                    c.a = baseColor.a;
                    texture.SetPixel(x, y, c);
                }
            }

            for (var i = 0; i < 7; i++)
            {
                Diagonal(texture, 10 + i * 34, 40 + i * 18, 72, new Color(0.86f, 0.98f, 1f, Mathf.Min(0.58f, baseColor.a)));
            }

            texture.Apply();
            SaveTextureMaterial(name, texturePath, texture, true, new Vector2(2.6f, 5.2f), Color.white);
        }

        private static void SaveTextureMaterial(string name, string texturePath, Texture2D texture, bool transparent, Vector2 scale, Color color)
        {
            File.WriteAllBytes(texturePath, texture.EncodeToPNG());
            UnityEngine.Object.DestroyImmediate(texture);
            AssetDatabase.ImportAsset(texturePath);

            var importedTexture = AssetDatabase.LoadAssetAtPath<Texture2D>(texturePath);
            if (importedTexture != null)
            {
                importedTexture.wrapMode = TextureWrapMode.Repeat;
                importedTexture.filterMode = FilterMode.Bilinear;
            }

            var path = MaterialFolder + "/" + name + ".mat";
            var mat = AssetDatabase.LoadAssetAtPath<Material>(path);
            if (mat == null)
            {
                mat = new Material(Shader.Find("Universal Render Pipeline/Lit") ?? Shader.Find("Standard"));
                AssetDatabase.CreateAsset(mat, path);
            }

            mat.color = color;
            mat.mainTexture = importedTexture;
            mat.SetTexture("_BaseMap", importedTexture);
            mat.mainTextureScale = scale;
            mat.SetTextureScale("_BaseMap", scale);
            if (transparent)
            {
                mat.SetFloat("_Surface", 1f);
                mat.SetFloat("_AlphaClip", 0f);
                mat.SetFloat("_ZWrite", 0f);
                mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                mat.renderQueue = 3000;
            }
            else
            {
                mat.renderQueue = -1;
            }

            TuneMaterial(mat, name, transparent);
            EditorUtility.SetDirty(mat);
        }

        private static void TuneMaterial(Material mat, string name, bool transparent)
        {
            if (mat.HasProperty("_BaseColor"))
            {
                mat.SetColor("_BaseColor", mat.color);
            }

            var smoothness = 0.18f;
            var metallic = 0f;
            if (name.Contains("Glass") || name.Contains("Ocean"))
            {
                smoothness = 0.86f;
            }
            else if (name.Contains("Metal") || name.Contains("Drain"))
            {
                smoothness = 0.58f;
                metallic = 0.45f;
            }
            else if (name.Contains("Wall"))
            {
                smoothness = 0.28f;
            }
            else if (name.Contains("Awning") || name == "Pink" || name == "Blue" || name == "Green" || name == "Yellow")
            {
                smoothness = 0.38f;
            }
            else if (name.Contains("Storefront"))
            {
                smoothness = 0.42f;
            }

            if (mat.HasProperty("_Smoothness"))
            {
                mat.SetFloat("_Smoothness", smoothness);
            }

            if (mat.HasProperty("_Metallic"))
            {
                mat.SetFloat("_Metallic", metallic);
            }

            if (transparent)
            {
                mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                if (mat.HasProperty("_Blend"))
                {
                    mat.SetFloat("_Blend", 0f);
                }
            }

            if (name.Contains("Storefront"))
            {
                if (mat.HasProperty("_Cull"))
                {
                    mat.SetFloat("_Cull", 0f);
                }

                mat.renderQueue = 2450;
            }
        }

        private static Color Shift(Color color, float amount)
        {
            return new Color(
                Mathf.Clamp01(color.r + amount),
                Mathf.Clamp01(color.g + amount),
                Mathf.Clamp01(color.b + amount),
                color.a);
        }

        private static void PaverMat(string name)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(256, 256, TextureFormat.RGBA32, false);
            var baseColor = new Color(0.69f, 0.68f, 0.64f);
            var warm = new Color(0.76f, 0.74f, 0.68f);
            var cool = new Color(0.62f, 0.63f, 0.61f);
            var joint = new Color(0.50f, 0.51f, 0.50f);

            for (var y = 0; y < 256; y++)
            {
                for (var x = 0; x < 256; x++)
                {
                    var block = ((x / 64) + (y / 64)) % 3;
                    texture.SetPixel(x, y, block == 0 ? baseColor : (block == 1 ? warm : cool));
                }
            }

            for (var p = 0; p < 256; p += 64)
            {
                Rect(texture, p, 0, 1, 256, joint);
                Rect(texture, 0, p, 256, 1, joint);
            }

            texture.Apply();
            File.WriteAllBytes(texturePath, texture.EncodeToPNG());
            UnityEngine.Object.DestroyImmediate(texture);
            AssetDatabase.ImportAsset(texturePath);

            var importedTexture = AssetDatabase.LoadAssetAtPath<Texture2D>(texturePath);
            if (importedTexture != null)
            {
                importedTexture.wrapMode = TextureWrapMode.Repeat;
                importedTexture.filterMode = FilterMode.Bilinear;
            }

            var path = MaterialFolder + "/" + name + ".mat";
            var mat = AssetDatabase.LoadAssetAtPath<Material>(path);
            if (mat == null)
            {
                mat = new Material(Shader.Find("Universal Render Pipeline/Lit") ?? Shader.Find("Standard"));
                AssetDatabase.CreateAsset(mat, path);
            }

            mat.color = Color.white;
            mat.mainTexture = importedTexture;
            mat.SetTexture("_BaseMap", importedTexture);
            mat.mainTextureScale = new Vector2(3f, 12f);
            mat.SetTextureScale("_BaseMap", new Vector2(3f, 12f));
            TuneMaterial(mat, name, false);
            EditorUtility.SetDirty(mat);
        }

        private static void FacadeMat(string name, Color accent, bool bakery)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(512, 512, TextureFormat.RGBA32, false);
            var wall = new Color(0.93f, 0.90f, 0.84f);
            var glassTop = new Color(0.64f, 0.86f, 0.98f);
            var glassBottom = new Color(0.18f, 0.35f, 0.43f);
            var frame = new Color(0.96f, 0.96f, 0.92f);
            var warm = new Color(1f, 0.80f, 0.45f);
            var dark = new Color(0.12f, 0.18f, 0.22f);

            for (var y = 0; y < 512; y++)
            {
                for (var x = 0; x < 512; x++)
                {
                    texture.SetPixel(x, y, wall);
                }
            }

            Rect(texture, 0, 0, 512, 48, new Color(0.54f, 0.53f, 0.50f));
            Rect(texture, 0, 330, 512, 64, accent);
            Rect(texture, 48, 82, 152, 210, dark);
            Rect(texture, 218, 82, 246, 210, glassBottom);
            Rect(texture, 58, 92, 132, 188, glassTop);
            Rect(texture, 230, 92, 222, 188, glassTop);
            Rect(texture, 48, 280, 416, 14, frame);
            Rect(texture, 48, 78, 416, 12, frame);

            for (var i = 0; i < 6; i++)
            {
                Rect(texture, 58 + i * 68, 400, 46, 74, glassTop);
                Rect(texture, 52 + i * 68, 394, 58, 86, frame);
            }

            for (var i = 0; i < 6; i++)
            {
                Rect(texture, i * 86, 306, 44, 24, i % 2 == 0 ? accent : new Color(1f, 0.88f, 0.68f));
            }

            Rect(texture, 70, 178, 110, 12, warm);
            Rect(texture, 248, 172, 180, 14, warm);
            Rect(texture, 250, 116, 176, 12, new Color(0.60f, 0.42f, 0.25f));
            Rect(texture, 250, 146, 176, 12, new Color(0.60f, 0.42f, 0.25f));

            for (var i = 0; i < 8; i++)
            {
                var productColor = bakery
                    ? (i % 2 == 0 ? new Color(1f, 0.65f, 0.76f) : new Color(1f, 0.87f, 0.58f))
                    : (i % 3 == 0 ? new Color(0.25f, 0.60f, 0.95f) : (i % 3 == 1 ? new Color(0.35f, 0.78f, 0.44f) : new Color(0.96f, 0.72f, 0.30f)));
                Rect(texture, 262 + i * 20, 126 + (i % 2) * 28, 14, 18, productColor);
            }

            for (var i = 0; i < 5; i++)
            {
                Diagonal(texture, 236 + i * 34, 112 + i * 10, 78, new Color(0.92f, 0.98f, 1f));
            }

            texture.Apply();
            File.WriteAllBytes(texturePath, texture.EncodeToPNG());
            UnityEngine.Object.DestroyImmediate(texture);
            AssetDatabase.ImportAsset(texturePath);

            var importedTexture = AssetDatabase.LoadAssetAtPath<Texture2D>(texturePath);
            if (importedTexture != null)
            {
                importedTexture.wrapMode = TextureWrapMode.Clamp;
                importedTexture.filterMode = FilterMode.Bilinear;
            }

            var path = MaterialFolder + "/" + name + ".mat";
            var mat = AssetDatabase.LoadAssetAtPath<Material>(path);
            if (mat == null)
            {
                mat = new Material(Shader.Find("Universal Render Pipeline/Lit") ?? Shader.Find("Standard"));
                AssetDatabase.CreateAsset(mat, path);
            }

            mat.color = Color.white;
            mat.mainTexture = importedTexture;
            mat.SetTexture("_BaseMap", importedTexture);
            TuneMaterial(mat, name, false);
            EditorUtility.SetDirty(mat);
        }

        private static void StorefrontDecalMat(string name, Color accent, bool bakery)
        {
            var texturePath = MaterialFolder + "/" + name + "_Texture.png";
            var texture = new Texture2D(512, 256, TextureFormat.RGBA32, false);
            var wall = bakery ? new Color(0.88f, 0.82f, 0.72f) : new Color(0.66f, 0.70f, 0.70f);
            var glassTop = new Color(0.66f, 0.88f, 0.98f);
            var glassBottom = new Color(0.20f, 0.38f, 0.46f);
            var frame = new Color(0.90f, 0.92f, 0.88f);
            var wood = new Color(0.56f, 0.36f, 0.18f);
            var warm = new Color(1f, 0.82f, 0.48f);
            var deep = new Color(0.12f, 0.19f, 0.22f);

            for (var y = 0; y < texture.height; y++)
            {
                for (var x = 0; x < texture.width; x++)
                {
                    var grain = (((x * 11 + y * 5) % 29) - 14) / 420f;
                    texture.SetPixel(x, y, Shift(wall, grain));
                }
            }

            Rect(texture, 0, 212, 512, 28, accent);
            Rect(texture, 0, 204, 512, 8, frame);
            if (!bakery)
            {
                Rect(texture, 0, 196, 512, 10, new Color(0.34f, 0.76f, 0.42f));
                Rect(texture, 0, 188, 512, 7, frame);
            }
            else
            {
                for (var stripe = 0; stripe < 10; stripe++)
                {
                    Rect(texture, stripe * 54, 188, 28, 24, stripe % 2 == 0 ? accent : new Color(1f, 0.86f, 0.66f));
                }
            }

            Rect(texture, 28, 26, 138, 156, deep);
            Rect(texture, 178, 26, 306, 156, deep);
            Rect(texture, 38, 36, 118, 136, glassTop);
            Rect(texture, 190, 36, 282, 136, glassTop);
            Rect(texture, 24, 182, 462, 8, frame);
            Rect(texture, 24, 22, 462, 8, frame);
            for (var mullion = 0; mullion < 5; mullion++)
            {
                Rect(texture, 180 + mullion * 62, 28, 6, 154, frame);
            }

            Rect(texture, 206, 78, 240, 8, wood);
            Rect(texture, 206, 116, 240, 8, wood);
            Rect(texture, 206, 154, 240, 8, wood);
            for (var i = 0; i < 12; i++)
            {
                var item = bakery
                    ? (i % 3 == 0 ? new Color(1f, 0.66f, 0.78f) : (i % 3 == 1 ? new Color(1f, 0.88f, 0.58f) : new Color(0.96f, 0.78f, 0.54f)))
                    : (i % 3 == 0 ? new Color(0.18f, 0.54f, 0.90f) : (i % 3 == 1 ? new Color(0.30f, 0.74f, 0.42f) : new Color(0.95f, 0.72f, 0.26f)));
                Rect(texture, 220 + i * 18, 88 + (i % 3) * 28, 10, 18, item);
            }

            if (bakery)
            {
                Rect(texture, 58, 64, 78, 10, warm);
                Rect(texture, 62, 94, 70, 10, wood);
                for (var i = 0; i < 5; i++)
                {
                    Rect(texture, 70 + i * 12, 104, 8, 9, i % 2 == 0 ? new Color(1f, 0.66f, 0.78f) : new Color(1f, 0.88f, 0.58f));
                }
            }
            else
            {
                Rect(texture, 54, 52, 80, 92, glassBottom);
                Rect(texture, 92, 52, 4, 92, frame);
                Rect(texture, 60, 148, 68, 7, warm);
            }

            for (var i = 0; i < 5; i++)
            {
                Diagonal(texture, 210 + i * 48, 52 + i * 10, 74, new Color(0.92f, 0.98f, 1f));
            }

            texture.Apply();
            SaveTextureMaterial(name, texturePath, texture, false, new Vector2(1f, 1f), Color.white);
        }

        private static void Rect(Texture2D texture, int x, int y, int width, int height, Color color)
        {
            for (var yy = y; yy < y + height; yy++)
            {
                if (yy < 0 || yy >= texture.height)
                {
                    continue;
                }

                for (var xx = x; xx < x + width; xx++)
                {
                    if (xx >= 0 && xx < texture.width)
                    {
                        texture.SetPixel(xx, yy, color);
                    }
                }
            }
        }

        private static void Diagonal(Texture2D texture, int x, int y, int length, Color color)
        {
            for (var i = 0; i < length; i++)
            {
                for (var thickness = 0; thickness < 4; thickness++)
                {
                    var xx = x + i;
                    var yy = y + i / 2 + thickness;
                    if (xx >= 0 && xx < texture.width && yy >= 0 && yy < texture.height)
                    {
                        texture.SetPixel(xx, yy, color);
                    }
                }
            }
        }

        private static void Fill(Texture2D texture, Color color)
        {
            for (var y = 0; y < texture.height; y++)
            {
                for (var x = 0; x < texture.width; x++)
                {
                    texture.SetPixel(x, y, color);
                }
            }
        }

        private static void Blit(Texture2D target, Texture2D source, int offsetX, int offsetY)
        {
            for (var y = 0; y < source.height; y++)
            {
                for (var x = 0; x < source.width; x++)
                {
                    target.SetPixel(offsetX + x, offsetY + y, source.GetPixel(x, y));
                }
            }

            UnityEngine.Object.DestroyImmediate(source);
        }

        private static void Mat(string name, Color color)
        {
            var path = MaterialFolder + "/" + name + ".mat";
            var mat = AssetDatabase.LoadAssetAtPath<Material>(path);
            if (mat == null)
            {
                mat = new Material(Shader.Find("Universal Render Pipeline/Lit") ?? Shader.Find("Standard"));
                AssetDatabase.CreateAsset(mat, path);
            }

            mat.color = color;
            if (color.a < 0.98f)
            {
                mat.SetFloat("_Surface", 1f);
                mat.SetFloat("_AlphaClip", 0f);
                mat.SetFloat("_ZWrite", 0f);
                mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                mat.renderQueue = 3000;
            }
            else
            {
                mat.renderQueue = -1;
            }
            TuneMaterial(mat, name, color.a < 0.98f);
            EditorUtility.SetDirty(mat);
        }

        private static void ApplyMaterial(GameObject go, string materialName)
        {
            var mat = LoadMaterial(materialName);
            if (mat != null)
            {
                go.GetComponent<Renderer>().sharedMaterial = mat;
            }
        }

        private static Material LoadMaterial(string materialName)
        {
            return AssetDatabase.LoadAssetAtPath<Material>(MaterialFolder + "/" + materialName + ".mat");
        }
    }
}
