        private static void Cloud(Transform parent, string name, Vector3 position, float scale)
        {
            var cloud = new GameObject(name);
            cloud.transform.SetParent(parent, false);
            cloud.transform.localPosition = position;
            Sphere(cloud.transform, "Puff_A", Vector3.zero, new Vector3(1.2f, 0.28f, 0.34f) * scale, "CloudWhite");
            Sphere(cloud.transform, "Puff_B", new Vector3(0.72f * scale, 0.08f * scale, 0f), new Vector3(0.82f, 0.22f, 0.28f) * scale, "CloudWhite");
            Sphere(cloud.transform, "Puff_C", new Vector3(-0.82f * scale, 0.02f * scale, 0f), new Vector3(0.76f, 0.2f, 0.25f) * scale, "CloudWhite");
        }

        private static void Label(Transform parent, string name, string text, Vector3 position, float size)
        {
            var label = new GameObject(name);
            label.transform.SetParent(parent, false);
            label.transform.localPosition = position;
            label.transform.localRotation = Quaternion.Euler(0f, 180f, 0f);
            var mesh = label.AddComponent<TextMesh>();
            mesh.text = text;
            mesh.fontSize = 64;
            mesh.characterSize = size * 0.1f;
            mesh.anchor = TextAnchor.MiddleCenter;
            mesh.alignment = TextAlignment.Center;
            mesh.color = Color.white;
        }

        private static void SideLabel(Transform parent, string name, string text, Vector3 position, float size, int side)
        {
            var label = new GameObject(name);
            label.transform.SetParent(parent, false);
            label.transform.localPosition = position;
            label.transform.localRotation = Quaternion.Euler(0f, side < 0 ? 90f : -90f, 0f);
            var mesh = label.AddComponent<TextMesh>();
            mesh.text = text;
            mesh.fontSize = 64;
            mesh.characterSize = size * 0.1f;
            mesh.anchor = TextAnchor.MiddleCenter;
            mesh.alignment = TextAlignment.Center;
            mesh.color = Color.white;
        }

