        private static void PlaceKenney(Transform parent, string name, string assetPath, Vector3 position, Vector3 rotation, Vector3 scale)
        {
            var asset = AssetDatabase.LoadAssetAtPath<GameObject>(assetPath);
            if (asset == null)
            {
                return;
            }

            var instance = PrefabUtility.InstantiatePrefab(asset, parent) as GameObject;
            if (instance == null)
            {
                instance = UnityEngine.Object.Instantiate(asset, parent);
            }

            instance.name = name;
            instance.transform.localPosition = position;
            instance.transform.localRotation = Quaternion.Euler(rotation);
            instance.transform.localScale = scale;
        }

        private static void PlaceThemedPrefab(Transform parent, string name, string assetPath, Vector3 position, Vector3 rotation, Vector3 scale, string accent)
        {
            var asset = AssetDatabase.LoadAssetAtPath<GameObject>(assetPath);
            if (asset == null)
            {
                Debug.LogWarning("[StarBay] Missing optional prefab: " + assetPath);
                return;
            }

            var instance = PrefabUtility.InstantiatePrefab(asset, parent) as GameObject;
            if (instance == null)
            {
                instance = UnityEngine.Object.Instantiate(asset, parent);
            }

            instance.name = name;
            instance.transform.localPosition = position;
            instance.transform.localRotation = Quaternion.Euler(rotation);
            instance.transform.localScale = scale;
            RepaintPrefabMaterials(instance, accent);
        }

        private static void RepaintPrefabMaterials(GameObject instance, string accent)
        {
            foreach (var renderer in instance.GetComponentsInChildren<MeshRenderer>(true))
            {
                var materialName = renderer.sharedMaterial != null ? renderer.sharedMaterial.name.ToLowerInvariant() : string.Empty;
                var objectName = renderer.gameObject.name.ToLowerInvariant();
                var chosen = "WallSlight";

                if (materialName.Contains("glass") || materialName.Contains("window") || objectName.Contains("glass") || objectName.Contains("window"))
                {
                    chosen = "Glass";
                }
                else if (materialName.Contains("metal") || objectName.Contains("rail") || objectName.Contains("antenna"))
                {
                    chosen = "Metal";
                }
                else if (materialName.Contains("green") || objectName.Contains("plant") || objectName.Contains("tree"))
                {
                    chosen = "PlantDark";
                }
                else if (objectName.Contains("sign") || objectName.Contains("trim") || objectName.Contains("stripe"))
                {
                    chosen = accent;
                }
                else if (objectName.Contains("roof") || objectName.Contains("floor"))
                {
                    chosen = "Concrete";
                }

                var mat = LoadMaterial(chosen);
                if (mat != null)
                {
                    renderer.sharedMaterial = mat;
                }
            }
        }

        private static GameObject Cube(Transform parent, string name, Vector3 position, Vector3 scale, string materialName)
        {
            var go = GameObject.CreatePrimitive(PrimitiveType.Cube);
            go.name = name;
            go.transform.SetParent(parent, false);
            go.transform.localPosition = position;
            go.transform.localScale = scale;
            ApplyMaterial(go, materialName);
            return go;
        }

        private static GameObject Quad(Transform parent, string name, Vector3 position, Vector3 scale, Vector3 rotation, string materialName)
        {
            var go = GameObject.CreatePrimitive(PrimitiveType.Quad);
            go.name = name;
            go.transform.SetParent(parent, false);
            go.transform.localPosition = position;
            go.transform.localRotation = Quaternion.Euler(rotation);
            go.transform.localScale = scale;
            ApplyMaterial(go, materialName);
            return go;
        }

        private static GameObject SlopedAwning(Transform parent, string name, Vector3 position, Vector3 size, string materialName)
        {
            var go = new GameObject(name);
            go.transform.SetParent(parent, false);
            go.transform.localPosition = position;

            var w = size.x * 0.5f;
            var d = size.z * 0.5f;
            var high = size.y * 0.5f;
            var low = -size.y * 0.5f;
            var thickness = Mathf.Max(0.045f, size.y * 0.22f);

            var mesh = new Mesh();
            mesh.name = name + "_Mesh";
            mesh.vertices = new[]
            {
                new Vector3(-w, high, d),
                new Vector3(w, high, d),
                new Vector3(-w, low, -d),
                new Vector3(w, low, -d),
                new Vector3(-w, high - thickness, d),
                new Vector3(w, high - thickness, d),
                new Vector3(-w, low - thickness, -d),
                new Vector3(w, low - thickness, -d)
            };
            mesh.triangles = new[]
            {
                0, 2, 1, 1, 2, 3,
                4, 5, 6, 5, 7, 6,
                0, 1, 4, 1, 5, 4,
                2, 6, 3, 3, 6, 7,
                0, 4, 2, 2, 4, 6,
                1, 3, 5, 3, 7, 5
            };
            mesh.uv = new[]
            {
                new Vector2(0f, 1f),
                new Vector2(1f, 1f),
                new Vector2(0f, 0f),
                new Vector2(1f, 0f),
                new Vector2(0f, 1f),
                new Vector2(1f, 1f),
                new Vector2(0f, 0f),
                new Vector2(1f, 0f)
            };
            mesh.RecalculateNormals();
            mesh.RecalculateBounds();

            go.AddComponent<MeshFilter>().sharedMesh = mesh;
            go.AddComponent<MeshRenderer>();
            ApplyMaterial(go, materialName);
            return go;
        }

